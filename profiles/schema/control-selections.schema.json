{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://esaf.dev/schema/profiles/control-selections/0.1.0",
  "title": "ESAF profile control selections",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "profile_id", "profile_version", "selections"],
  "properties": {
    "$schema": {"const": "../../schema/control-selections.schema.json"},
    "schema_version": {"const": "0.1.0"},
    "profile_id": {"$ref": "#/$defs/profileId"},
    "profile_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "selections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/selection"}}
  },
  "$defs": {
    "profileId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*--[a-z0-9]+(?:-[a-z0-9]+)*--[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "identifier": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$"},
    "controlId": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{1,15}-[0-9]{3}$"},
    "nonEmptyString": {"type": "string", "minLength": 1},
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_id", "status", "rationale"],
      "properties": {
        "control_id": {"$ref": "#/$defs/controlId"},
        "status": {"enum": ["required", "conditional", "recommended", "not_selected"]},
        "rationale": {"$ref": "#/$defs/nonEmptyString"},
        "activation_conditions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "conditional"}}, "required": ["status"]}, "then": {"required": ["activation_conditions"]}, "else": {"not": {"required": ["activation_conditions"]}}}
      ]
    }
  }
}
