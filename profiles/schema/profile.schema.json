{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://esaf.dev/schema/profiles/profile/0.1.0",
  "title": "ESAF profile manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "profile_id", "profile_version", "status", "target_esaf_release", "control_catalog", "title", "scope", "applicability_conditions", "source_boundary", "components", "change_history"],
  "properties": {
    "$schema": {"const": "../../schema/profile.schema.json"},
    "schema_version": {"const": "0.1.0"},
    "profile_id": {"$ref": "#/$defs/profileId"},
    "profile_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["proposed", "draft", "approved", "published", "deprecated", "retired"]},
    "target_esaf_release": {"$ref": "#/$defs/nonEmptyString"},
    "control_catalog": {"$ref": "#/$defs/controlCatalog"},
    "title": {"$ref": "#/$defs/nonEmptyString"},
    "scope": {"$ref": "#/$defs/nonEmptyString"},
    "applicability_conditions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/applicabilityCondition"}},
    "source_boundary": {"$ref": "#/$defs/sourceBoundary"},
    "components": {"$ref": "#/$defs/components"},
    "change_history": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/change"}}
  },
  "$defs": {
    "profileId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*--[a-z0-9]+(?:-[a-z0-9]+)*--[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "identifier": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$"},
    "nonEmptyString": {"type": "string", "minLength": 1},
    "relativePath": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"},
    "stringArray": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
    "controlCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schema_version", "sha256", "records"],
      "properties": {
        "path": {"const": "controls/catalog.json"},
        "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "records": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/controlRecord"}
        }
      }
    },
    "controlRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "status", "path", "record_sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z]{3}-[1-9][0-9]{2}$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "status": {"enum": ["proposed", "draft", "approved", "published", "deprecated", "retired"]},
        "path": {"type": "string", "pattern": "^([A-Z]{3})/\\1-[0-9]{3}\\.md$"},
        "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "applicabilityCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition_id", "question", "answer_type", "activates_when", "resolution_evidence"],
      "properties": {
        "condition_id": {"$ref": "#/$defs/identifier"},
        "question": {"$ref": "#/$defs/nonEmptyString"},
        "answer_type": {"const": "boolean"},
        "activates_when": {"type": "boolean"},
        "resolution_evidence": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "sourceBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "permitted_sources", "excluded_sources"],
      "properties": {
        "statement": {"$ref": "#/$defs/nonEmptyString"},
        "permitted_sources": {"$ref": "#/$defs/stringArray"},
        "excluded_sources": {"$ref": "#/$defs/stringArray"}
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "readme", "control_selections", "risk_overlays", "evidence_expectations", "external_references"],
      "properties": {
        "source": {"$ref": "#/$defs/relativePath"},
        "readme": {"$ref": "#/$defs/relativePath"},
        "control_selections": {"$ref": "#/$defs/relativePath"},
        "risk_overlays": {"$ref": "#/$defs/relativePath"},
        "evidence_expectations": {"$ref": "#/$defs/relativePath"},
        "external_references": {"$ref": "#/$defs/relativePath"}
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "date", "author", "description"],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "date": {"type": "string", "format": "date"},
        "author": {"$ref": "#/$defs/nonEmptyString"},
        "description": {"$ref": "#/$defs/nonEmptyString"}
      }
    }
  }
}
