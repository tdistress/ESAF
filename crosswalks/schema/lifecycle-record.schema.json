{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://esaf-standard.org/schemas/lifecycle-record.schema.json",
  "title": "ESAF crosswalk lifecycle record",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "mapping_set_id", "snapshot_digest", "events"],
  "properties": {
    "schema_version": {"$ref": "#/$defs/semver"}, "mapping_set_id": {"$ref": "#/$defs/mappingSetId"},
    "snapshot_digest": {"$ref": "#/$defs/sha256"}, "events": {"type": "array", "items": {"$ref": "#/$defs/event"}}
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "format": "date"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "mappingSetId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*--[a-z0-9]+(?:-[a-z0-9]+)*--[a-z0-9]+(?:[.-][a-z0-9]+)*--esaf-[a-z0-9]+(?:[.-][a-z0-9]+)*--(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "state", "date", "actor", "reason", "previous_event_digest", "event_digest"],
      "properties": {
        "event_id": {"$ref": "#/$defs/slug"}, "state": {"enum": ["approved", "published", "deprecated", "retired"]}, "date": {"$ref": "#/$defs/date"},
        "actor": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1},
        "predecessor_id": {"$ref": "#/$defs/mappingSetId"}, "successor_id": {"$ref": "#/$defs/mappingSetId"}, "approval_reference": {"type": "string", "minLength": 1},
        "previous_event_digest": {"$ref": "#/$defs/sha256"}, "event_digest": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
